{
  "name": "remotion-promo-video-pipeline",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:capture": "node scripts/setup-capture.mjs",
    "make-demo-assets": "node scripts/make-demo-assets.mjs",
    "studio": "pnpm --filter @remotion-promo-video-pipeline/remotion studio",
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @remotion-promo-video-pipeline/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @remotion-promo-video-pipeline/web build",
    "typecheck": "pnpm --filter @remotion-promo-video-pipeline/web typecheck",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "verify": "pnpm check:agent-docs && pnpm verify:api && pnpm verify:web",
    "verify:api": "pnpm lint:api && pnpm test:api && pnpm check:structure",
    "verify:web": "pnpm lint && pnpm test:web && pnpm build",
    "verify:full": "pnpm run doctor && pnpm verify && pnpm test:e2e",
    "lint": "pnpm --filter @remotion-promo-video-pipeline/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:web": "pnpm --filter @remotion-promo-video-pipeline/web test",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @remotion-promo-video-pipeline/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
