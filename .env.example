# ---------------------------------------------------------------------------
# Backblaze B2 (required) — the only credentials this app needs.
# Create a bucket + an application key with Read and Write permission:
# https://www.backblaze.com/sign-up/ai-cloud-storage?utm_source=github&utm_medium=referral&utm_campaign=ai_artifacts&utm_content=b2ai-remotion-promo-video-pipeline
# ---------------------------------------------------------------------------
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region only — the S3 endpoint is derived as https://s3.<region>.backblazeb2.com
# so no region literal is ever baked into source. Copy the middle segment of the
# "Endpoint" shown on your bucket page: s3.<region>.backblazeb2.com -> <region>.
B2_REGION=your_b2_region

# Optional: public base URL for the bucket, used only to build direct object
# URLs when the bucket is public. Leave unset — the app serves every render,
# poster and capture through short-lived presigned URLs instead.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.your-region.backblazeb2.com

# Optional: full S3 endpoint override. Only needed for a non-standard endpoint;
# normally leave this unset and let B2_REGION derive it.
# B2_ENDPOINT=https://s3.your-region.backblazeb2.com

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=NOT_A_REAL_KEY_paste_yours_here
# B2_BUCKET_NAME=my-promo-renders
# B2_REGION=us-west-004

# ---------------------------------------------------------------------------
# Render pipeline — ALL OPTIONAL.
#
# Every key below is commented out because every one already has a working
# default in services/api/app/config/settings.py, and the value shown after each
# name IS that default. So a filled-in .env genuinely needs only the B2 block
# above. Uncomment a line to override it.
# ---------------------------------------------------------------------------
# demo  -> 1280x720, 6s `release-teaser` preset, 2 variants (laptop-friendly)
# full  -> 1920x1080, all four variants (the write-amplification headliner)
# RENDER_PRESET=demo
# Explicit overrides for the preset's frame size (unset = use the preset).
# RENDER_WIDTH=1280
# RENDER_HEIGHT=720
# RENDER_FPS=30
# Remotion render parallelism. `auto` resolves to max(1, min(cpu_count // 2, 8)),
# clamped so it can never resolve to 0. Set an integer to pin it.
# RENDER_CONCURRENCY=auto
# RENDER_VARIANTS=master-16x9,vertical-9x16
# Optional GPU rasterization for Remotion's headless Chrome. Unset (CPU) by
# default; `angle` is the usual choice on macOS, `swiftshader` for headless CI.
# REMOTION_GL=
# Uploading every intermediate PNG frame to B2 is the point of this sample.
# FRAME_UPLOAD_ENABLED=true
# FRAME_UPLOAD_CONCURRENCY=8

# Capture + authoring defaults, surfaced as form hints in the UI.
# CAPTURE_URL_DEFAULT=http://localhost:3000
# PROMO_PRODUCT_DEFAULT=demo-product

# Binary resolution. Leave unset: ffmpeg falls back to the bundled
# imageio-ffmpeg wheel, then to `ffmpeg` on PATH; node falls back to `node`.
# FFMPEG_BINARY=
# NODE_BINARY=

# ---------------------------------------------------------------------------
# API service knobs — ALSO ALL OPTIONAL, shown with their defaults.
# ---------------------------------------------------------------------------
# API_PORT=8000
# Interactive API docs (/docs, /redoc, /openapi.json). Set false to hide the
# full API surface in production.
# ENABLE_DOCS=true
# Exact frontend origins allowed by CORS. Override in production.
# API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Dev-only escape hatch: a regex of additional allowed origins. NEVER in prod.
# API_CORS_ORIGIN_REGEX=
# Per-IP rate limits (per 60s window). The write tier covers uploads, deletes,
# presigns and render kicks; it is generous because one promo detail page
# presigns a URL per variant plus its poster.
# RATE_LIMIT_PER_MINUTE=600
# RATE_LIMIT_WRITE_PER_MINUTE=300
# Max bytes for an ingested asset (brand file, audio bed, manual capture).
# MAX_FILE_SIZE=104857600
# Confine key-addressed reads/deletes to a prefix when the bucket is shared with
# other workloads, e.g. renders/. Empty accepts any key shape.
# ALLOWED_KEY_PREFIX=
# Small durable counter file, relative to services/api/.
# DOWNLOAD_COUNT_FILE=data/download_count.json

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
